<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RegDocs.Ingest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.*" />
    <!-- Ollama client; implements IEmbeddingGenerator from Microsoft.Extensions.AI -->
    <PackageReference Include="OllamaSharp" Version="5.*" />
    <!-- Postgres driver + pgvector's `vector` type -->
    <PackageReference Include="Npgsql" Version="9.*" />
    <PackageReference Include="Pgvector" Version="0.3.*" />
  </ItemGroup>

</Project>
